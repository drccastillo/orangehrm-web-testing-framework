# =============================================================================
# OrangeHRM Test Automation Framework - Environment Configuration
# =============================================================================
# This file documents all REQUIRED environment variables for the framework.
# Copy this file to .env and replace the example values with your actual configuration.
#
# ⚠️  IMPORTANT: ALL variables listed here are REQUIRED.
# ⚠️  The framework will raise ConfigurationException if any variable is missing.
#
# Usage:
#   1. Copy this file: cp .env.example .env
#   2. Update all values in .env with your configuration
#   3. Never commit .env to version control (it's in .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Base URL of the OrangeHRM application under test
URL=https://opensource-demo.orangehrmlive.com/web/index.php

# Valid user credentials for login tests
# Note: Variable names must be exactly as shown (ORANGEHRM_USERNAME, not USER)
ORANGEHRM_USERNAME=Admin
ORANGEHRM_PASSWORD=admin123

# -----------------------------------------------------------------------------
# Browser Configuration
# -----------------------------------------------------------------------------
# Browser to use for tests
# Valid values: chrome, chromium, firefox, edge, webkit
# Note: This framework uses Playwright for automation
PW_BROWSER=chromium

# Run tests in headless mode (no visible browser window)
# Valid values: True, False (case-insensitive)
HEADLESS=False

# -----------------------------------------------------------------------------
# Timeout Configuration (in seconds)
# -----------------------------------------------------------------------------
# Default timeout for element interactions and waits
# Must be a positive integer
DEFAULT_TIMEOUT=10

# Timeout for page load operations
# Must be a positive integer
PAGE_LOAD_TIMEOUT=30

# -----------------------------------------------------------------------------
# Window Configuration
# -----------------------------------------------------------------------------
# Browser window width in pixels
# Must be a positive integer
WINDOW_WIDTH=1920

# Browser window height in pixels
# Must be a positive integer
WINDOW_HEIGHT=1080

# Maximize browser window on startup
# Valid values: True, False (case-insensitive)
# Note: If True, WINDOW_WIDTH and WINDOW_HEIGHT are ignored
MAXIMIZE_WINDOW=True

# -----------------------------------------------------------------------------
# Screenshot Configuration
# -----------------------------------------------------------------------------
# Automatically capture screenshot on test failure
# Valid values: True, False (case-insensitive)
# Screenshots are saved to: reports/screenshots/
SCREENSHOT_ON_FAILURE=True

# =============================================================================
# Configuration Validation Notes
# =============================================================================
# - PW_BROWSER: Validated against BrowserType enum (chrome|chromium|firefox|edge|webkit)
# - Timeouts and dimensions: Validated as positive integers (> 0)
# - Boolean values: Case-insensitive ("true", "True", "TRUE" all work)
# - Missing variables: Will cause ConfigurationException with clear error message
#
# For more information, see: src/config/environment_config.py
# =============================================================================
