  "validation_scenarios": [
    {
      "id": "dynamic_end_date_update",
      "description": "Verify end date updates dynamically when month changes",
      "test_sequence": [
        {
          "step": 1,
          "action": "select_month",
          "month": "January",
          "expected_end": "December 31"
        },
        {
          "step": 2,
          "action": "select_month",
          "month": "June",
          "expected_end": "May 31"
        },
        {
          "step": 3,
